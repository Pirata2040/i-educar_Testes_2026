<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração usada só para medir a cobertura do SimilarPersonService (issue #1233).
  O phpunit.xml do projeto mede app/, ieducar/ e src/ inteiros, o que gera um relatório de centenas de MB.

  O comando para gerar o relatório está em docs/tdd-1233/README.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd" bootstrap="../../vendor/autoload.php" colors="true" cacheDirectory="../../.phpunit.cache">
  <testsuites>
    <testsuite name="SimilarPerson">
      <file>../../tests/Unit/Services/SimilarPersonServiceTest.php</file>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <file>../../app/Services/SimilarPersonService.php</file>
    </include>
  </source>
  <coverage>
    <report>
      <html outputDirectory="cobertura/html"/>
      <text outputFile="cobertura/cobertura.txt" showUncoveredFiles="true"/>
      <clover outputFile="cobertura/clover.xml"/>
    </report>
  </coverage>
</phpunit>
